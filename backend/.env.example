# Riot developer portal: https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Platform host for Summoner + Spectator (e.g. na1, euw1, kr)
RIOT_PLATFORM=na1

# Regional route for Match-v5 (americas, europe, sea, asia)
RIOT_REGION=americas

# How to find live games: featured (Riot featured spectator list, mixed ELO, default) |
# seeders (only SEEDER_PUUIDS) | both (merge).
POROBOOK_DISCOVERY_MODE=featured

# Comma-separated PUUIDs — optional if using featured or both; required for seeders-only
SEEDER_PUUIDS=

# Optional: only for local script scripts/fetch_puuid.py (your Riot ID, not a secret)
# RIOT_GAME_NAME=YourInGameName
# RIOT_TAGLINE=TAG

# Optional: override Data Dragon version (default: latest from versions.json)
# DDRAGON_VERSION=15.1.1

# Demo: synthesize war-room numbers for UI polish (set 0 in production)
POROBOOK_DEMO_STATS=0

# Min resolved (scored) predictions required to appear on /api/leaderboard (default 10)
# LEADERBOARD_MIN_RESOLVED=10
